# OLMo 3 production pipeline input contract.
#
# Copy to a deployment-owned path. Empty values are unresolved inputs; the
# repository does not assign cluster paths, credentials, experiment identity,
# or locally selected optimizer schedules.

# Runtime
OLMO3_ROOT=
OLMO3_CONDA_ENV=olmo3-mindspeed-pipeline
OLMO3_ASCEND_WHEELHOUSE=
OLMO3_ASCEND_HOME=/usr/local/Ascend/ascend-toolkit/latest
OLMO3_CANN_ENV_SCRIPT=/usr/local/Ascend/ascend-toolkit/set_env.sh
TRAIN_PYTHON=

# Immutable upstream data and tokenizer snapshots
BASE_TOKENIZER_REPO=allenai/dolma2-tokenizer
BASE_TOKENIZER_REV=5292e5d6c0f40b67cc765fe41bec991cf4345b5c
SFT_TOKENIZER_REPO=allenai/dolma-2-tokenizer-olmo-3-instruct-final
SFT_TOKENIZER_REV=55f211dfda3974963b869e490617447045069a64
OPEN_INSTRUCT_REPO=https://github.com/allenai/open-instruct.git
OPEN_INSTRUCT_REV=78d1e5aa3cf80a73ce56fd0775e7ad959faf2660

# Shared storage
RAW_ROOT=
TOKENIZED_ROOT=
DATA_WORK_ROOT=
DATA_CONTRACT_ROOT=
TOKENIZER_ROOT=
CHECKPOINT_ROOT=
OUTPUT_ROOT=

# Architecture chain
MODEL=                         # 1b | 3b | 7b
VARIANT=                       # base | siamese_depth

# Stage 1 optimizer schedule. No local default is implied.
STAGE1_TRAIN_TOKENS=
STAGE1_PEAK_LR=
STAGE1_MIN_LR=
STAGE1_WARMUP_TOKENS=
# Optional shared Megatron sample-index cache; empty keeps the run-local default.
STAGE1_DATA_CACHE_PATH=
STAGE1_TOPOLOGY=
STAGE1_PERFORMANCE=
STAGE1_WORLD_SIZE=
STAGE1_NNODES=
STAGE1_RUN_ID=
STAGE1_MASTER_PORT=
STAGE1_HCCL_IF_BASE_PORT=
STAGE1_RESUME_RUN_ID=
STAGE1_RESUME_MASTER_PORT=
STAGE1_RESUME_HCCL_IF_BASE_PORT=

# Stage 2 optimizer schedule.
STAGE2_TRAIN_TOKENS=100000000000
STAGE2_PEAK_LR=
STAGE2_MIN_LR=
STAGE2_WARMUP_TOKENS=0
STAGE2_TOPOLOGY=stage2_cp2_512npu
STAGE2_PERFORMANCE=cp_single_halo
STAGE2_WORLD_SIZE=512
STAGE2_NNODES=32
STAGE2_RUN_ID=
STAGE2_MASTER_PORT=
STAGE2_HCCL_IF_BASE_PORT=
STAGE2_TRANSITION_MASTER_PORT=
STAGE2_TRANSITION_HCCL_IF_BASE_PORT=

# Stage 3 optimizer schedule.
STAGE3_TRAIN_TOKENS=50000000000
STAGE3_PEAK_LR=
STAGE3_MIN_LR=
STAGE3_WARMUP_TOKENS=
STAGE3_TOPOLOGY=stage3_cp16_1024npu
STAGE3_PERFORMANCE=cp_single_halo
STAGE3_WORLD_SIZE=1024
STAGE3_NNODES=64
STAGE3_RUN_ID=
STAGE3_MASTER_PORT=
STAGE3_HCCL_IF_BASE_PORT=
STAGE3_TRANSITION_MASTER_PORT=
STAGE3_TRANSITION_HCCL_IF_BASE_PORT=

# Stage 4 Think SFT. Empty warmup tokens retain the stage's 3% warmup.
THINK_EPOCHS=2
THINK_PEAK_LR=
THINK_MIN_LR=0
THINK_WARMUP_TOKENS=
THINK_EXPECTED_INSTANCES=
THINK_EXPECTED_FINGERPRINT=
THINK_RUN_ID=
THINK_MASTER_PORT=
THINK_HCCL_IF_BASE_PORT=
THINK_TRANSITION_MASTER_PORT=
THINK_TRANSITION_HCCL_IF_BASE_PORT=

# Stage 4 Instruct SFT. The main chain loads the completed Think checkpoint.
# Empty warmup tokens retain the stage's 3% warmup.
INSTRUCT_EPOCHS=2
INSTRUCT_PEAK_LR=
INSTRUCT_MIN_LR=0
INSTRUCT_WARMUP_TOKENS=
INSTRUCT_EXPECTED_INSTANCES=
INSTRUCT_EXPECTED_FINGERPRINT=
INSTRUCT_RUN_ID=
INSTRUCT_MASTER_PORT=
INSTRUCT_HCCL_IF_BASE_PORT=
INSTRUCT_TRANSITION_MASTER_PORT=
INSTRUCT_TRANSITION_HCCL_IF_BASE_PORT=

# Stage 4 shared topology
SFT_TOPOLOGY=sft_cp8_256npu
SFT_PERFORMANCE=cp_single_halo
SFT_WORLD_SIZE=256
SFT_NNODES=16

# Distributed runtime. NODE_RANK is supplied separately by every worker.
NPROC_PER_NODE=16
NODE_RANK=
MASTER_ADDR=

# Optional telemetry. Empty WANDB_PROJECT disables W&B.
WANDB_PROJECT=
WANDB_ENTITY=
WANDB_BASE_URL=
